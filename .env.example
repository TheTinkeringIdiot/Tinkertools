# Settings of the container stack (docker-compose.yml). Copy to .env for a
# local run; in Coolify, set them as the resource's environment variables.
# Every key has a default in docker-compose.yml: only the password must be set
# on a server.

# PostgreSQL role, password and database of the `db` service. The password is
# put into a URL: generate one without special characters, e.g.
#   openssl rand -hex 24
POSTGRES_USER=tinkertools
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tinkertools

# Port on 127.0.0.1 of the host that reaches the `web` service.
WEB_PORT=8088

# API worker processes. Each can reach about 500 MB with the cache bound below.
API_WORKERS=2
# Most memory one worker's response cache may hold, in bytes (0 turns it off).
RESPONSE_CACHE_MAX_BYTES=268435456

# Origins other than the site's own that may call the API from a browser.
CORS_ORIGINS=https://ao.tinkeringidiot.com,https://prk.tinkeringidiot.com

LOG_LEVEL=INFO

# PostgreSQL memory, for a host with about 8 GB.
DB_SHARED_BUFFERS=1GB
DB_EFFECTIVE_CACHE_SIZE=3GB

# Build-time: JSON object of hostnames whose first visit opens another game
# family than the default build's. Default: {"prk.tinkeringidiot.com":"prk"}
# VITE_VERSION_HOSTNAME_MAP=
